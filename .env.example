# ─────────────────────────────────────────────────────────────────
# MacroPulse Sentinel — Environment Configuration
#
# ✅ FULLY FREE MINIMUM SETUP (no credit card, no paid API keys):
#
#   1. Install Ollama: https://ollama.com
#      → ollama pull llama3.2
#      → ollama serve          (keep running in background)
#
#   2. Get free Gemini key (optional, cloud fallback):
#      → https://aistudio.google.com/app/apikey
#
#   3. Get Telegram bot token (free, from @BotFather on Telegram):
#      → /newbot → copy the token
#
#   4. Price feed: yfinance uses Yahoo Finance, zero config needed.
#
#   5. Twitter: Nitter RSS requires no API key. Just set TWITTER_MODE=rss.
# ─────────────────────────────────────────────────────────────────


# ── LLM — FREE LOCAL: Ollama ────────────────────────────────────
# No API key needed. Runs on your machine.
# Install: https://ollama.com  →  ollama pull llama3.2
# Supported free models: llama3.2, mistral, phi3, gemma2
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── LLM — FREE CLOUD: Google Gemini ────────────────────────────
# Free tier: 1,500 requests/day, no credit card required.
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── LLM — PAID FALLBACKS (optional, only used if above fail) ───
# Groq has a free tier but requires account signup: https://console.groq.com
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── TELEGRAM (free — just needs @BotFather) ─────────────────────
# Step 1: Open Telegram, message @BotFather → /newbot
# Step 2: Copy the token below
TELEGRAM_BOT_TOKEN=1234567890:ABCDEF_your_bot_token_here

# Step 3: Get your channel/group chat ID
# Option A: Add @JsonDumpBot to your group → it shows the chat ID
# Option B: Send a message to your channel, then call:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890


# ── PRICE FEED — FREE: Yahoo Finance (yfinance) ─────────────────
# No API key required. Uses Yahoo Finance data.
# Symbols used: GC=F (Gold), NQ=F (Nasdaq 100), JPY=X (USD/JPY)
# Note: ~10-15 min delay on futures data in free tier.
# For live scalping, use twelvedata (requires key).
PRICE_FEED_PROVIDER=yfinance    # yfinance | twelvedata | mock

# Only needed if PRICE_FEED_PROVIDER=twelvedata
TWELVEDATA_API_KEY=


# ── TWITTER/X — FREE: Nitter RSS (no key needed) ────────────────
# TWITTER_MODE=rss polls Nitter RSS for all 23 monitored accounts.
# No Twitter API key required.
# For the official API stream (lower latency), set mode=api and add bearer token.
TWITTER_MODE=rss               # rss (free) | api (needs token) | disabled
TWITTER_BEARER_TOKEN=          # only needed if TWITTER_MODE=api


# ── RISK PARAMETERS ─────────────────────────────────────────────
ACCOUNT_SIZE=25000
MAX_RISK_PER_TRADE=25
MAX_DAILY_LOSS=750


# ── OPERATIONAL ─────────────────────────────────────────────────
# Set DRY_RUN=true to test without sending Telegram messages
DRY_RUN=false
LOG_LEVEL=INFO
DEDUP_DB_PATH=./data/dedup.db
CALENDAR_POLL_FAST_SECONDS=5
CALENDAR_POLL_IDLE_SECONDS=60
RSS_POLL_INTERVAL_SECONDS=15
